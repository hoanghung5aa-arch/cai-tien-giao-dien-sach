@model Genre
@{ ViewData["Title"] = "Chỉnh sửa thể loại"; }
<div class="form-page">
    <a asp-action="Index" class="back-link">Quay lại danh sách thể loại</a>
    <div class="form-heading"><span class="eyebrow eyebrow-dark">Danh mục phim</span><h1>Chỉnh sửa thể loại</h1><p>Cập nhật tên thể loại đang dùng.</p></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="editor-card genre-editor">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="Id" />
        <div class="field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" maxlength="200" /><span asp-validation-for="Name"></span></div>
        <div class="form-actions"><a asp-action="Index" class="btn btn-outline-forest">Hủy</a><button type="submit" class="btn btn-forest">Lưu thay đổi</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
