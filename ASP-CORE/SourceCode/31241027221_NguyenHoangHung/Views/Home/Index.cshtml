@{ ViewData["Title"] = "Góc Phim Hưng"; }
<section class="hero-panel hero-no-feature">
    <div class="hero-copy">
        <span class="eyebrow">Cửa hàng phim trực tuyến</span>
        <h1>Góc Phim Hưng</h1>
        <p>Duyệt phim theo thể loại, xem thông tin từng tựa phim và tạo đơn hàng ngay trên cửa hàng.</p>
        <div class="hero-actions">
            <a class="btn btn-forest" asp-controller="Movies" asp-action="Index">Mở danh mục phim</a>
            <a class="btn btn-outline-forest" asp-controller="Genres" asp-action="Index">Xem thể loại</a>
        </div>
    </div>
</section>
