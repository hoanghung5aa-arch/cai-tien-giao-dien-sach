@page
@model _31241027221_NguyenHoangHung.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác nhận email";
}

<section class="account-page account-page-wide">
    <div class="account-card">
        <span class="eyebrow">Tài khoản Góc Phim Hưng</span>
        <h1>Xác nhận email</h1>
        <p class="account-intro">Tài khoản <strong class="account-email">@Model.Email</strong> đã được tạo. Cần xác nhận email trước khi đăng nhập.</p>

        @if (Model.EmailConfirmed)
        {
            <div class="alert alert-success" role="status">Email này đã được xác nhận. Bạn có thể đăng nhập.</div>
            <a class="btn btn-primary" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a>
        }
        else
        {
            @if (Model.DisplayConfirmAccountLink && !string.IsNullOrWhiteSpace(Model.EmailConfirmationUrl))
            {
                <div class="alert alert-info" role="status">Đường dẫn xác nhận chỉ hiển thị ở môi trường phát triển cục bộ.</div>
                <a class="btn btn-primary mb-4" href="@Model.EmailConfirmationUrl">Xác nhận tài khoản</a>
            }

            @if (Model.EmailDeliveryStatus == "failed" || Model.ResendStatus == "failed")
            {
                <div class="alert alert-warning" role="alert">Tài khoản đã được tạo nhưng yêu cầu gửi email xác nhận chưa thành công. Kiểm tra cấu hình SMTP rồi gửi lại email.</div>
            }
            else if (Model.ResendStatus == "confirmed")
            {
                <div class="alert alert-success" role="status">Email này đã được xác nhận. Bạn có thể đăng nhập.</div>
            }
            else if (Model.EmailDeliveryStatus == "sent" || Model.ResendStatus == "sent")
            {
                <div class="alert alert-success" role="status">Email xác nhận đã được gửi. Kiểm tra hộp thư đến và thư rác.</div>
            }
            else if (!Model.DisplayConfirmAccountLink)
            {
                <div class="alert alert-info" role="status">Nếu chưa nhận email xác nhận, hãy kiểm tra thư rác hoặc yêu cầu gửi lại email.</div>
            }

            <form method="post" asp-page-handler="Resend" class="mt-3">
                <input type="hidden" name="email" value="@Model.Email" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-outline-forest">Gửi lại email xác nhận</button>
            </form>
        }
    </div>
</section>
